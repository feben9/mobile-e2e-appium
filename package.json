{
  "name": "mobile-e2e-appium",
  "version": "1.0.0",
  "private": true,
  "description": "Android end-to-end tests for Sauce Labs' public My Demo App, written with WebdriverIO, Appium 2 and TypeScript.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch-app": "bash scripts/fetch-app.sh",
    "test": "wdio run wdio.conf.ts",
    "test:smoke": "wdio run wdio.conf.ts --suite smoke",
    "test:known-defects": "KNOWN_DEFECTS=1 wdio run wdio.conf.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "@wdio/allure-reporter": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "eslint": "^9.39.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "webdriverio": "^9.32.0"
  }
}
